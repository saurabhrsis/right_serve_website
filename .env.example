# ---------------------------------------------------------------------------
# Public (browser-safe) configuration. Never put secrets in VITE_* variables —
# everything prefixed with VITE_ is embedded in the client bundle.
# ---------------------------------------------------------------------------

# Base URL of the existing backend API that receives enquiries.
# Leave empty in production to use the default: https://backend.rightserveinfotechsystem.com
VITE_API_BASE_URL=

# Origin used by the Vite dev-server proxy for /api/* requests.
VITE_API_ORIGIN=https://backend.rightserveinfotechsystem.com

# Public site URL (used for canonical URLs, Open Graph tags and sitemap).
VITE_SITE_URL=https://rightserveinfotechsystem.com

# --- Optional analytics (injected at runtime, disabled when empty) ----------
# Google Tag Manager container, e.g. GTM-XXXXXXX
VITE_GTM_ID=
# Google Analytics 4 measurement ID, e.g. G-XXXXXXXXXX
VITE_GA4_ID=
