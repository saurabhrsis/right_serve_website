# ------------------------------------------------------------------
# Right Serve Infotech System - website environment variables
# Copy this file to `.env` and adjust the values for your server.
# ------------------------------------------------------------------

# Public site URL (used for canonical tags, sitemap, JSON-LD, share previews)
VITE_SITE_URL=https://rightserveinfotechsystem.com

# Existing backend base URL.
#  - Leave EMPTY to use the same-origin `/api` reverse proxy (recommended).
#  - Set it to call the backend directly (backend must send CORS headers).
VITE_API_BASE_URL=

# Dev-server proxy target (used by `npm run dev` only)
VITE_BACKEND_URL=https://backend.rightserveinfotechsystem.com

# Analytics / marketing (optional - leave empty to disable the script entirely)
VITE_GA4_ID=
VITE_GTM_ID=
VITE_META_PIXEL_ID=
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=

# Leave empty unless you own the "bhajnarthi" app listing
VITE_WHATSAPP_NUMBER=919545073418
