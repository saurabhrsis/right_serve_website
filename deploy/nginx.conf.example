# ---------------------------------------------------------------------------
# Nginx example for the prerendered Right Serve Infotech System website.
# The build output in `dist/` contains a real HTML file per route
# (dist/about/index.html, dist/services/software/index.html, ...), so no SPA
# fallback is required for those paths - only the 404 handler is customised.
# ---------------------------------------------------------------------------
server {
    listen 80;
    server_name rightserveinfotechsystem.com www.rightserveinfotechsystem.com;
    return 301 https://rightserveinfotechsystem.com$request_uri;
}

server {
    listen 443 ssl http2;
    server_name rightserveinfotechsystem.com;
    root /var/www/rightserve/dist;
    index index.html;

    # SSL (certbot managed)
    ssl_certificate     /etc/letsencrypt/live/rightserveinfotechsystem.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/rightserveinfotechsystem.com/privkey.pem;

    gzip on;
    gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;
    gzip_min_length 1024;

    # Hashed build assets - cache forever
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
        try_files $uri =404;
    }

    # Optimised images
    location /images/ {
        add_header Cache-Control "public, max-age=2592000";
        try_files $uri =404;
    }

    # Same-origin API proxy -> existing backend (avoids CORS entirely)
    location /api/ {
        proxy_pass https://backend.rightserveinfotechsystem.com/;
        proxy_set_header Host backend.rightserveinfotechsystem.com;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_ssl_server_name on;
    }

    # Clean URLs: serve /about from dist/about/index.html
    location / {
        try_files $uri $uri/index.html $uri/ @notfound;
    }

    location @notfound {
        return 404 /404.html;
    }

    error_page 404 /404.html;
    error_page 500 502 503 504 /404.html;
}
