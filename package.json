{
  "name": "right-serve-website",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Corporate website for Right Serve Infotech System Pvt. Ltd. — custom software development and industry software solutions.",
  "scripts": {
    "dev": "vite",
    "build": "npm run sitemap && tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "build:client": "vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "sitemap": "node scripts/generate-sitemap.mjs"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.0.18",
    "lucide-react": "^0.454.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^6.30.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.13.0",
    "@types/node": "^26.6.4",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "eslint": "^9.13.0",
    "eslint-plugin-react-hooks": "^5.0.0",
    "eslint-plugin-react-refresh": "^0.4.14",
    "globals": "^15.11.0",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.12.0",
    "vite": "^5.4.10"
  }
